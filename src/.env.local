# FastAPI Boilerplate - Environment Configuration (Local Development)
# =============================================================================
# Database Configuration - Using SQLite for Local Development
# -------------------------------------------------------------------------
USE_SQLITE=True

# Postgres Configuration (Commented out for future production use)
# -------------------------------------------------------------------------
# POSTGRES_USER=myuser
# POSTGRES_PASSWORD=mypassword
# POSTGRES_SERVER=192.168.121.147
# POSTGRES_PORT=5432
# POSTGRES_DB="mydb"
# POSTGRES_ASYNC_PREFIX="postgresql+asyncpg://"

# Crypt Settings
# -------------------------------------------------------------------------
# SECRET_KEY=de2132a4a3a029d6a93a2aefcb519f0219990f92ca258a7c5ed938a444dbe1c8
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin User Settings
# -------------------------------------------------------------------------
# ADMIN_NAME="admin"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="Admin01!"

# Redis Configuration (Disabled for local development)
# -------------------------------------------------------------------------
# REDIS_CACHE_HOST=192.168.121.147
# REDIS_CACHE_PASSWORD=mypassword
# REDIS_CACHE_PORT=6379

# REDIS_QUEUE_HOST=192.168.121.147
# REDIS_QUEUE_PORT=6379

# REDIS_RATE_LIMIT_HOST=192.168.121.147
# REDIS_RATE_LIMIT_PORT=6379
# REDIS_RATE_LIMIT_PASSWORD=mypassword

# DISABLED Redis for local development
REDIS_RATE_LIMIT_ENABLED=false

# Application Settings
# -------------------------------------------------------------------------
APP_NAME="FastAPI app"
APP_DESCRIPTION="FastAPI Boilerplate - Modular Architecture"
APP_VERSION="0.1.0-modular"
LICENSE_NAME="MIT"
CONTACT_NAME="Developer"
CONTACT_EMAIL="dev@example.com"

# Environment Settings
# -------------------------------------------------------------------------
ENVIRONMENT=local

# CORS Settings
# -------------------------------------------------------------------------
CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Billing & Stripe Configuration (Phase 3)
# -------------------------------------------------------------------------
# ENCRYPTION_KEY is used for Fernet symmetric encryption of Stripe API keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=
# ENCRYPTION_SALT=

# # ------------- email -------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME="FastAPI SaaS"

# #-------------- SSO Providers-------------
# GOOGLE_CLIENT_ID=<your-google-client-id>
# GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# GITHUB_CLIENT_ID=<your-github-client-id>
# GITHUB_CLIENT_SECRET=<your-github-client-secret>
# MICROSOFT_CLIENT_ID=<your-microsoft-client-id>
# MICROSOFT_CLIENT_SECRET=<your-microsoft-client-secret>
# APPLE_CLIENT_ID=<your-apple-client-id>
# APPLE_CLIENT_SECRET=<your-apple-client-secret>

# #-------------- S3 Storage------------------
# S3_BUCKET_NAME=<your-bucket>
# S3_ENDPOINT_URL=<minio-or-aws-endpoint>
# AWS_ACCESS_KEY_ID=<access-key>
# AWS_SECRET_ACCESS_KEY=<secret-key>

# # -------------- BILLING (STRIPE)-----------------
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# # -------------- AI/LLM (OLLAMA) -------------- 
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT=120.0
# OLLAMA_DEFAULT_MODEL=gemma3
# OLLAMA_MAX_CONNECTIONS=100

# # ------------- client side cache -------------
# CLIENT_CACHE_MAX_AGE=60

# # ------------- CORS -------------
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
# CORS_METHODS=["*"]
# CORS_HEADERS=["*"]

