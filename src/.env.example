# src/.env.example - TEMPLATE. Copy to src/.env and fill in. Never commit src/.env.
#
# WHY THIS FILE EXISTS
# --------------------
# Criterion (e) of the Phase-0 Step 1 exit gate requires "a clean-checkout dry
# run reproduces the declared configuration". A clean checkout has no src/.env,
# because src/.env is gitignored and must stay that way. So the CONFIGURATION
# SHAPE has to live in the repository or (e) is unsatisfiable by construction -
# and, before this file existed, nothing recorded which variables the harness
# reads at all.
#
# That absence is not cosmetic. Perf finding P-4 was that every locust baseline
# in the Round-1 pack was produced with the security controls DISABLED or
# relaxed, and no report disclosed the override. The values were not wrong in
# isolation; they were wrong AND invisible. This template makes the declared
# configuration explicit for the same reason.
#
# SECRETS
# -------
# No real secret belongs in this file. The values below are placeholders that are
# obviously not credentials. SECRET_KEY in particular must satisfy three checks
# (src/app/core/config/crypt.py):
#   1. non-empty
#   2. NOT in KNOWN_LEAKED_SECRET_KEYS - this repo has real keys in its history
#      and refuses to start on them
#   3. long enough for HS256
# Generate one with:  openssl rand -hex 32
#
# THE TWO GOTCHAS THAT COST REAL TIME
# ----------------------------------
# 1. PERF_TEST_EMAILS MUST BE SHORT. The seeder derives users.username from the
#    email, and users.username is varchar(20). A generated address like
#    perf_user_1@example.com is 23 characters and the INSERT fails on the column,
#    not on the value you would expect. Use qa0@e.io and increment.
# 2. THE FIXTURE PASSWORD CONTAINS "!". bash history expansion eats it, so a
#    `curl -d "password=...!"` silently posts an empty field and returns 422
#    "field missing" - which reads exactly like a broken login endpoint. Put the
#    body in a file (`--data-binary @body.json`) instead of inlining it.

# ---------------------------------------------------------------------------
# REQUIRED SECRETS - no defaults, the app refuses to boot without them
# ---------------------------------------------------------------------------
# Generate: openssl rand -hex 32
SECRET_KEY=replace_me_with_openssl_rand_hex_32_output

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# POSTGRES_ASYNC_PREFIX is appended to build the async DSN; the app derives its
# own URLs from the discrete fields, so setting only DATABASE_URL will not do.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=fastapi_saas_db
POSTGRES_ASYNC_PREFIX=postgresql+asyncpg://

# ---------------------------------------------------------------------------
# REDIS
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# ENVIRONMENT
# ---------------------------------------------------------------------------
# local | staging | production. Anything other than "local" tightens validation.
ENVIRONMENT=local
DEBUG=False
LOG_LEVEL=INFO
# Leave OFF for a load run: the profiler's own timing hooks change the thing
# being measured. Only the instrumentation harnesses turn it on.
QUERY_PROFILER_ENABLED=False

# ---------------------------------------------------------------------------
# CRYPTO / TOKENS
# ---------------------------------------------------------------------------
# 8=30ms(dev) 10=100ms 12=250ms(default) 14=1000ms. Clamped to 8..14.
#
# THIS IS A MEASUREMENT VARIABLE, NOT A TUNING KNOB. The certified run recorded
# login p50 at 3,000 ms, which is rounds=12 on 2 cores under 50 concurrent
# authentications. It scales with cores, so a core-count change invalidates
# comparison against that baseline. Record it with the run.
BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_SESSION_DURATION_DAYS=30
# Defaults to min(32, max(4, cpu_count * 2)).
# BCRYPT_THREAD_POOL_SIZE=8
ALGORITHM=HS256

# ---------------------------------------------------------------------------
# RATE LIMITING - PRODUCTION VALUES. See the P-4 warning above.
# ---------------------------------------------------------------------------
# Leaving these at their relaxed values is exactly what voided the Round-1 pack.
# A rate-limited request in production is rejected in single-digit milliseconds;
# under relaxed budgets it succeeds, so the run measures a code path production
# never takes.
#
# Overriding is legitimate for a phase that is NOT a security measurement, and
# illegitimate for one that is. Either way, RECORD IT IN THE ARTEFACT. A run
# whose overrides are not disclosed is the P-4 defect.
#
# AUTO_BAN_ENABLED=true
#
# SECURITY_BUDGETS is a dict[str, tuple[int,int]] as JSON, budget name ->
# (count, seconds). The production set, verbatim from
# src/app/core/config/services.py:
#   {"auth": [5, 60], "mfa_verify": [5, 60], "mfa_verify_global": [15, 60],
#    "mfa_mutate": [5, 60], "magic_link_send": [3, 60], "passkey_login": [10, 60],
#    "refresh": [60, 60], "ai_chat": [60, 60]}
# SECURITY_BUDGETS={"auth": [5, 60], "mfa_verify": [5, 60], "mfa_verify_global": [15, 60], "mfa_mutate": [5, 60], "magic_link_send": [3, 60], "passkey_login": [10, 60], "refresh": [60, 60], "ai_chat": [60, 60]}
#
# Anonymous and authenticated path limits, per hour.
# DEFAULT_ANONYMOUS_LIMIT=10
# DEFAULT_AUTHENTICATED_LIMIT=1000
#
# ANONYMOUS_IP_AGGREGATE_LIMIT is NOT one of the budgets above and is NOT part of
# SECURITY_BUDGETS. It caps the number of distinct per-path keys ONE ip address
# may create per window - 300/3600 by default - so it fires on load generation
# even after every budget above has been relaxed. It keys on the PEER address, not
# on X-Forwarded-For, so giving each virtual user its own client IP does not spread
# it. A run that trips it is void under 4.5 (any non-zero rate-limit event voids
# the run), which is how a 50-minute matrix run was lost once already.
# ANONYMOUS_IP_AGGREGATE_LIMIT=(300,3600)
#
# THE PLAN NAMES FOUR RATE LIMITS AND THE APP READS EIGHT. Four are listed above
# (AUTO_BAN_ENABLED, SECURITY_BUDGETS, DEFAULT_AUTHENTICATED_LIMIT,
# DEFAULT_ANONYMOUS_LIMIT); these are the other four, all of which a load run will
# trip if left at their defaults, which is how two 45-minute Step-4 matrix runs
# were voided (645 then 20,696 violations) while every documented budget looked
# relaxed.
#
# TIER_RATE_LIMITS is a dict[str, tuple[int,int]] by TIER NAME, per-USER-per-PATH:
# keyed `tenant:<id>:rate_limit:user:<user>:<path>`. Spreading load across 300
# accounts does NOT help - each account still hits its own ceiling on the hot
# path. Production: free 10/3600, basic 100/3600, pro 1000/3600, enterprise
# 10000/3600.
# TIER_RATE_LIMITS={"free": [10, 3600], "basic": [100, 3600], "pro": [1000, 3600], "enterprise": [10000, 3600]}
#
# DEFAULT_RATE_LIMIT_LIMIT and DEFAULT_RATE_LIMIT_PERIOD are PLAIN INTS, not
# tuples - the fallback used when no tier and no per-path policy matches. Setting
# them as "[1000,3600]" is a startup validation error (which at least fails loud).
# DEFAULT_RATE_LIMIT_LIMIT=1000
# DEFAULT_RATE_LIMIT_PERIOD=3600

# ---------------------------------------------------------------------------
# PERF HARNESS FIXTURE
# ---------------------------------------------------------------------------
# Accounts the load generator authenticates as. Each virtual user gets its own
# account so none exceeds the concurrent-session cap. SHORT - see gotcha 1.
PERF_TEST_EMAILS=qa0@e.io,qa1@e.io,qa2@e.io,qa3@e.io,qa4@e.io
PERF_TEST_USER_COUNT=50
# Gotcha 2 applies to this value too.
PERF_TEST_PASSWORD=replace_me
PERF_TEST_TENANT=test-tenant-e2e

# Tier the fixture accounts are created in. An un-tiered account falls back to
# the ANONYMOUS budget, so a run that forgets this voids on 429s instead of
# measuring. 2 = premium.
PERF_TIER_ID=2
PERF_TIER_NAME=premium

# RBAC role granted to the fixture accounts. Without it every permission-gated
# route answers 403, which caps the measurable endpoint matrix at the
# unauthenticated and self-service routes.
PERF_ROLE_NAME=perf-fixture
# READ-ONLY BY DESIGN. users:manage or notifications:manage would let a load
# test mutate state, and a benchmark that writes is not measuring a read path.
PERF_PERMISSION_SLUGS=users:read,notifications:read

# ---------------------------------------------------------------------------
# PERF RUN SHAPE
# ---------------------------------------------------------------------------
# Where the load generator sends traffic. Defaults to http://localhost:8000.
# On the two-host setup this was the app host, not the load host - a benchmark
# pointed at the wrong address measures loopback and reports it as network.
API_HOST=http://localhost:8000

# Logout REVOKES the session, so any request behind it carries dead credentials.
# Weight 10 is the default and is deliberately unchanged - the decision to weight
# it 0 is recorded per phase, never made silently by editing this file.
# Set to 0 to CERTIFY a phase; disclose it in the artefact.
PERF_LOGOUT_WEIGHT=10

# Whether the stores are co-located with the app or remote. Affects whether the
# Redis-cost programme's relevance survives contact with your topology, so it is
# a declared fact rather than an assumption.
# PERF_STORE_LOCALITY=co-local

# Deployment topology, recorded into the run manifest.
# PERF_ORCHESTRATOR=self-hosted-perf-load
# PERF_IMAGE_DIGEST=sha256:...

# ---------------------------------------------------------------------------
# NOT FOR .env
# ---------------------------------------------------------------------------
# Measured per run, never configured: p50/p95/p99, RSS window, sampler cost,
# host identity, image digest. These are OUTPUT. Putting them here would make
# the instrument's own budget a setting, which is how a ceiling stops meaning
# anything.
#
# process_series.SAMPLER_COST_CEILING_US is 50.0 us/tick, chosen in advance and
# never relaxed. The recorded Linux run came in at 164 us median - 328% over
# budget. That is an open defect, tracked separately, and it is recorded in the
# artefact rather than configured away.
