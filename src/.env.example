# SECURITY_BUDGETS are the identity-keyed brute-force defences (login, MFA
# verify, passkey login, magic-link send/verify, refresh, AI chat), keyed budget
# name -> [count, seconds]. The production set, verbatim from
# src/app/core/config/services.py. These were referenced by the P-4 block below
# but NOT declared, so the budgets actually in force were invisible.
#
# Adding a budget to services.py makes this block REQUIRED to match it: the boot
# gate (validate_budget_definitions) refuses to start when a leg names a budget
# that is not configured here, so a stale copy fails loudly at deploy rather
# than KeyError-ing on the first request.
SECURITY_BUDGETS={"auth":[5,60],"mfa_verify":[5,60],"mfa_verify_global":[15,60],"mfa_mutate":[5,60],"magic_link_send":[3,60],"magic_link_verify":[30,60],"passkey_login":[10,60],"refresh":[60,60],"ai_chat":[60,60]}
# Budgets that keep BLOCKING even when RATE_LIMIT_FAIL_OPEN=True (a Redis outage
# must not open the brute-force doors). Removing a name here weakens the control.
SECURITY_BUDGETS_FAIL_CLOSED=["auth","mfa_verify","mfa_verify_global","mfa_mutate","magic_link_send","magic_link_verify","passkey_login","refresh"]

