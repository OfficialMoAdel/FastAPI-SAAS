REDIS_CACHE_HOST=localhost
REDIS_CACHE_PASSWORD=
REDIS_CACHE_PORT=6379

# ------------- redis queue -------------
# REDIS_QUEUE_ENABLED lives in the "queue domain" block below, for the same reason.
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PASSWORD=
REDIS_QUEUE_PORT=6379

# ------------- redis admin (CRUDAdmin session store) -------------
# NOTE: there is NO rate-limit Redis settings class in this project. Rate-limit
# state lives on the CACHE Redis above, so REDIS_RATE_LIMIT_HOST/PORT/PASSWORD
# are not app settings and are not declared here (two operator probe scripts
# read REDIS_RATE_LIMIT_PASSWORD; see the scripts note at the bottom).
CRUD_ADMIN_REDIS_ENABLED=True
CRUD_ADMIN_REDIS_HOST=localhost
CRUD_ADMIN_REDIS_PASSWORD=
CRUD_ADMIN_REDIS_PORT=6379

# ------------- email -------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=replace_me
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME="FastAPI SaaS"

#-------------- SSO Providers------------- 
# NO VARIABLES HERE, DELIBERATELY. OAuth client credentials are NOT read from the
# environment: they are stored ENCRYPTED in the `sso_settings` table
# (src/app/modules/auth/models.py - client_id / client_secret are BYTEA) and are
# managed through the SSO settings admin API. Declaring
# GOOGLE_CLIENT_ID / GITHUB_CLIENT_ID / MICROSOFT_CLIENT_ID / APPLE_CLIENT_ID here
# (plus their _SECRET pair) was actively harmful: nothing reads them, so an
# operator would "configure SSO" and get a provider that stays disabled. The only
# per-deployment knob is ENCRYPTION_KEY above, which is what encrypts them.

#-------------- Object storage ------------------
# STORAGE_BUCKET / AWS_ENDPOINT_URL are the REAL field names (StorageSettings).
# S3_BUCKET_NAME / S3_ENDPOINT_URL bind nothing -- they were the misspelling this
# template shipped, and setting them silently left the app on its defaults.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -------------- BILLING (STRIPE)-----------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# -------------- AI/LLM (OLLAMA) --------------
# AI_ENABLED / AI_ACTIVE_PROVIDER decide whether the AI module is reachable at
# all and which provider serves it. Omitted previously, so an operator could not
# see (or change) the provider without reading the settings module.
AI_ENABLED=True
AI_ACTIVE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120.0
OLLAMA_DEFAULT_MODEL=gemma3
OLLAMA_MAX_CONNECTIONS=100

# ------------- client side cache -------------
CLIENT_CACHE_MAX_AGE=60

