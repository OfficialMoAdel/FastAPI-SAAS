# ============================================================================
# src/.env.example - TEMPLATE. Copy to src/.env and fill in. Never commit src/.env.
# ============================================================================
# WHY THIS FILE EXISTS
# --------------------
# Criterion (e) of the Phase-0 Step 1 exit gate requires "a clean-checkout dry
# run reproduces the declared configuration". A clean checkout has no src/.env
# (it is gitignored and must stay that way), so the CONFIGURATION SHAPE has to
# live in the repository or (e) is unsatisfiable by construction. An
# undocumented variable is a variable nobody checks: perf finding P-4 was that
# every Round-1 baseline ran with security controls relaxed and NO report
# disclosed the override.
#
# THIS MIRRORS src/.env WITH PLACEHOLDER VALUES ONLY. No real secret belongs
# here. SECRET_KEY must be non-empty, absent from KNOWN_LEAKED_SECRET_KEYS
# (src/app/core/config/crypt.py) and long enough for HS256:
#   openssl rand -hex 32
#
# THE TWO GOTCHAS THAT COST REAL TIME
# ----------------------------------
# 1. PERF_TEST_EMAILS MUST BE SHORT (see the PERF HARNESS FIXTURE section):
#    users.username is varchar(20) and the seeder derives it from the email, so
#    perf_user_1@example.com fails the INSERT on the column, not the value.
# 2. PERF_TEST_PASSWORD CONTAINS "!". bash history expansion eats it, so
#    `curl -d "password=...!"` posts an empty field and returns 422 "field
#    missing", which reads exactly like a broken login endpoint. Put the body
#    in a file (`--data-binary @body.json`) instead of inlining it.
#
# NOTE ON DUPLICATE KEYS: this file is loaded last-wins (python-dotenv via
# pydantic-settings), so a variable must be declared EXACTLY ONCE below. A
# second declaration silently overrides the value you edited in the first.
#
# WHAT BELONGS HERE (and what does not)
# ------------------------------------
# This file is reconciled against the Settings model, not hand-assembled. Three
# kinds of key appear below and they are labelled, because they are NOT
# interchangeable:
#   1. SETTINGS FIELDS - pydantic binds them; the name must match the field
#      (plus its class env_prefix) EXACTLY or the value is silently ignored.
#   2. HARNESS / TEST BOOTSTRAP - read with os.environ in scripts/, src/benchmarks/
#      and tests/conftest.py. NOT Settings fields: setting them configures the
#      harness, not the app.
#   3. INERT / NOT-CONFIG - declared because a reader needs to know the name
#      exists, with a note saying it does nothing.
# A key in category 1 that is misspelled is the worst outcome: it looks
# configured and silently falls back to a default. If you add a setting, add it
# here with the exact field name; tests/unit/scripts/test_env_example_*
# asserts both directions (every required field declared, no dead key declared).
# ============================================================================

# ------------- app settings -------------
APP_NAME="My Project"
APP_DESCRIPTION="My Project Description"
APP_VERSION="0.1"
CONTACT_NAME="Me"
CONTACT_EMAIL="my.email@example.com"
LICENSE_NAME="MIT"

# ------------- database -------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_saas_db
# DSN prefixes. The app builds its own URLs from the discrete fields above, so
# setting only POSTGRES_URL does NOT redirect the app: POSTGRES_URL is the
# optional explicit override the SQLAlchemy setup prefers when present, and the
# two PREFIX values are the fallback fragments.
POSTGRES_ASYNC_PREFIX="postgresql+asyncpg://"
POSTGRES_SYNC_PREFIX="postgresql://"
POSTGRES_URL=

# Connection pool. These are the values that decide whether the pool survives
# concurrency: DB_POOL_SIZE + DB_MAX_OVERFLOW is the hard ceiling on simultaneous
# DB work, and a benchmark that exhausts it measures connection queueing, not the
# endpoint. Declared because they were previously invisible (Settings defaults
# shown here).
DB_WORKERS=1
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_STATEMENT_CACHE_SIZE=100
POSTGRES_MAX_CONNECTIONS=100

# SQLite is the TEST harness backend, not a deployment target. USE_SQLITE is
# currently INERT: nothing in src/app branches on it (verified: the only repo hit
# is its own definition), so flipping it does not switch the app to SQLite.
# Declared so the name is not a surprise; the SQLITE_* values below are what
# tests/conftest.py builds its engine from.
USE_SQLITE=True
SQLITE_URI="./sql_app.db"
SQLITE_SYNC_PREFIX="sqlite:///"
SQLITE_ASYNC_PREFIX="sqlite+aiosqlite:///"

# ------------- test_database (HARNESS / TEST BOOTSTRAP - not Settings fields) -------------
# Read by tests/conftest.py and tests/integration/conftest.py with os.getenv, so
# they are NOT bound by pydantic. POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_SERVER are declared once (in the database block above); repeating them
# here would silently win over whatever was edited there.
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_DB=fastapi_saas_test


# ------------- crypt -------------
# SECRET_KEY: HS256 signing key, >=32 chars. Generate with: openssl rand -hex 32
SECRET_KEY=replace_me_with_openssl_rand_hex_32_output
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------- security -------------
# ENCRYPTION_KEY is NOT a passphrase and NOT a hex digest. It is handed straight
# to cryptography's Fernet, which requires EXACTLY 32 url-safe base64-encoded
# bytes (44 chars). `openssl rand -hex 32` produces 64 hex chars and Fernet
# rejects it with "Fernet key must be 32 url-safe base64-encoded bytes" -- a
# failure that only surfaces at the first encrypt/decrypt (passkey write, Stripe
# secret read), never at boot. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# ENCRYPTION_SALT IS a passphrase salt (not a Fernet key). openssl rand -hex 32 is correct here.
ENCRYPTION_SALT=
IP_WHITELIST_ENABLED=False
IP_WHITELIST_BYPASS_RATE_LIMIT=False

# Attack detection kill switches — both default true; flip to false only during an incident
# true=O(n) linear scanner; false=combined regex fallback
ATTACK_DETECTION_LINEAR_SCAN=true
# true=necessary-literal prefilter; false=full regex on every scan
ATTACK_DETECTION_BRANCH_PRUNE=true

# AUTO_BAN_ENABLED defaults to TRUE in src/app/core/config/security.py and the
# secure value is what ships here. A perf run may set it false -- that override
# belongs in the disclosure block at the bottom of this file, never as the
# template default: the Round-1 pack was voided precisely because baselines ran
# with it false and no report said so (finding P-4).
AUTO_BAN_ENABLED=True

# ------------- admin -------------
ADMIN_NAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
# ADMIN_PASSWORD is REQUIRED and validated: >=16 chars with at least one
# lowercase, uppercase, digit and one of @$!%*?&. A non-compliant placeholder
# makes a clean checkout fail to boot (Field(..., min_length=16) + complexity
# validators), which defeats the purpose of this template. The value below
# satisfies every rule and is obviously not a credential.
ADMIN_PASSWORD=Replace_me_Str0ng!Passw0rd
# Admin Panel
CRUD_ADMIN_ENABLED=False

# ------------- redis cache -------------
# REDIS_CACHE_ENABLED lives with the rest of the cache tunables in the
