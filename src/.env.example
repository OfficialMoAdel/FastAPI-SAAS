# ---------------------------------------------------------------------------
# PERF HARNESS FIXTURE (HARNESS / TEST BOOTSTRAP - not Settings fields)
# ---------------------------------------------------------------------------
# Accounts the load generator authenticates as. Each virtual user gets its own
# account so none exceeds the concurrent-session cap. SHORT - see gotcha 1:
# users.username is varchar(20) and the seeder derives it from the email, so a
# generated perf_user_1@example.com (23 chars) fails the INSERT on the column.
PERF_TEST_EMAILS=qa0@e.io,qa1@e.io,qa2@e.io,qa3@e.io,qa4@e.io
PERF_TEST_USER_COUNT=50
# Gotcha 2 applies to this value too: the "!" is eaten by bash history expansion.
PERF_TEST_PASSWORD=replace_me
PERF_TEST_TENANT=test-tenant-e2e

# Fixture ACCOUNT tier. NOT a variable: these are Python constants in
# src/benchmarks/perf_accounts.py (PERF_TIER_ID = 2, PERF_TIER_NAME = "premium"),
# pinned by tests/unit/benchmarks/test_perf_account_naming.py. They were
# documented as env vars here once and setting them did nothing - change the
# constants and the test together if the fixture tier ever moves. An un-tiered
# account falls back to the ANONYMOUS budget, so a run that forgets this voids on
# 429s instead of measuring.

# RBAC role granted to the fixture accounts. NOT variables: PERF_ROLE_NAME and
# PERF_PERMISSION_SLUGS are Python constants in scripts/setup_locust_test_data.py.
# Declaring them here as env vars was a no-op. Their READ-ONLY intent is the part
# worth keeping: users:manage or notifications:manage would let a load test
# mutate state, and a benchmark that writes is not measuring a read path.
# Listed (commented) so the names stay discoverable and the read-only grant is
# visible in the same place as the rest of the fixture; editing them here changes
# NOTHING - edit the constants and their test instead.
# PERF_ROLE_NAME=perf-fixture
# PERF_PERMISSION_SLUGS=users:read,notifications:read

# Fraction of locust tasks that log out (weight out of 100). Production value
# 10. Set 0 to certify a run as a logout-free phase - a phase certified with
# PERF_LOGOUT_WEIGHT left at its default was NOT logout-free (see
# scripts/endpoint_phase_b.py). Read through the locustfile's _int_env helper,
# which is why no static gate can see it.
PERF_LOGOUT_WEIGHT=10

# Where the load generator sends traffic. Defaults to http://localhost:8000.
# On the two-host setup this was the app host, not the load host - a benchmark
# pointed at the wrong address measures loopback and reports it as network.
API_HOST=http://localhost:8000

# ---------------------------------------------------------------------------
# PERF RUN MANIFEST (HARNESS / TEST BOOTSTRAP - not Settings fields)
# ---------------------------------------------------------------------------
# Read by src/benchmarks/run_manifest.py. These three were documented before the
# template rewrite and were dropped, which made a run's own provenance
# undeclarable. They are recorded into the artefact, not consumed by the app.
#
# PERF_IMAGE_DIGEST is the digest of the image actually running. Shape-validated
# on the way in; an absent value is RECORDED AS ABSENT and the run labelled
# non-representative -- never invented.
# PERF_IMAGE_DIGEST=sha256:<64 hex chars>
#
# Deployment topology, recorded into the run manifest. Neither this repository
# nor a CI runner is a substitute for declaring it.
# PERF_ORCHESTRATOR=self-hosted-perf-load
#
# Whether the stores are co-located with the app or remote. It decides whether
# the Redis-cost programme's relevance survives contact with your topology, so it
# is a declared fact rather than an assumption. Values: co-local | remote.
# PERF_STORE_LOCALITY=co-local

# Harness credentials for scripts that log in as a real user rather than seeding
# one. Read by src/benchmarks/m2_refresh_commit_ab.py and scripts/profile_refresh.py.
# Kept out of the app blocks above because they configure a script, not the app.
# TEST_EMAIL=qa0@e.io
# TEST_PASSWORD=replace_me

# ---------------------------------------------------------------------------
# OPERATOR / PROBE SCRIPTS (read with os.environ, NOT Settings fields)
# ---------------------------------------------------------------------------
# Four scripts (span_cost.py, store_rtt_probe.py, users_list_probe.py,
# clear_rate_limit_state.py) connect to Redis directly and fall back SILENTLY to
# 127.0.0.1 when these are unset -- so on any non-local topology an unset value
# makes a probe measure the wrong server and report it as fact. The app itself
# uses REDIS_CACHE_* / REDIS_QUEUE_* above; these are the scripts' own view.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0
# Two of those probes also accept the rate-limit Redis password under this name.
# REDIS_RATE_LIMIT_PASSWORD=

# ---------------------------------------------------------------------------
# VALIDATOR-ONLY SWITCH (read with os.getenv, NOT a Settings field)
# ---------------------------------------------------------------------------
# src/app/core/env_validator.py reads DEBUG to decide whether to warn that a
# production deployment is running with debug on. It is NOT the app's log level
# (that is LOG_LEVEL above). Declared so the warning has a documented trigger.
# DEBUG=False

# ---------------------------------------------------------------------------
# SECURITY CONTROLS A PERF RUN MAY RELAX - AND MUST DISCLOSE
# ---------------------------------------------------------------------------
# P-4: the Round-1 baselines were produced with AUTO_BAN_ENABLED=false and
# relaxed budgets, and no report disclosed the override. Overriding is
# legitimate for a phase that is NOT a security measurement, and illegitimate
# for one that is. Either way, RECORD IT IN THE ARTEFACT.
#
# NOTE: AUTO_BAN_ENABLED and SECURITY_BUDGETS are declared ACTIVE at their secure
# production values further up this file (security + rate-limiting blocks). To
