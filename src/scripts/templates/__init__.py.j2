"""{{ ModelName }} module.

Components are imported lazily to avoid circular imports.
"""

__all__ = [
    "{{ ModelName }}",
    "{{ ModelName }}Service",
    "router",
]


def __getattr__(name: str):
    """Lazy import to avoid circular imports."""
    if name == "router":
        from src.app.modules.{{ module_name }}.router import router
        return router
    if name == "{{ ModelName }}Service":
        from src.app.modules.{{ module_name }}.service import {{ ModelName }}Service
        return {{ ModelName }}Service
    if name == "{{ ModelName }}":
        from src.app.modules.{{ module_name }}.models import {{ ModelName }}
        return {{ ModelName }}
    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
