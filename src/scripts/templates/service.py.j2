class {{ ModelName }}Service(BaseService[{{ ModelName }}]):
    """Service class for {{ module_name }}-related business logic.

    Tenant isolation note: ``self.crud`` is a TenantAwareCRUD — the
    tenant_id filter is injected from request context on every call.
    Service methods therefore do NOT take (or pass) explicit ``tenant_id``
    kwargs; a caller-supplied value would be ignored (and logged) by the
    seam.

    B4: this template used to import the module-level
    ``crud_{{ module_name }}`` symbol, which was DEAD — ``BaseService.__init__``
    builds its own ``self.crud`` via ``scoped_crud(db, model)``, and every
    method body calls ``self.crud``. The import was never referenced, so a
    generated service carried a module-level symbol it did not use (and
    whose absence no test would have caught).
    """

    def __init__(self, db: AsyncSession):
        """Initialize {{ ModelName }}Service.

        Parameters
        ----------
        db : AsyncSession
            Database session
        """
        super().__init__({{ ModelName }}, db, select_schema={{ ModelName }}Read)

    async def create_{{ module_name }}(
        self,
        data: {{ ModelName }}Create,
        current_user: AuthenticatedUser,
    ) -> {{ ModelName }}Read:
        """Create a new {{ module_name }}.

        Parameters
        ----------
        data : {{ ModelName }}Create
            Creation data
        current_user : AuthenticatedUser
            Currently authenticated user (already validated by auth)

        Returns
        -------
        {{ ModelName }}Read
            Created {{ module_name }}

        Raises
        ------
        DuplicateError
            If {{ fields[0].name if fields else 'name' }} already exists
        """
        # Check for duplicates (tenant filter injected by the CRUD seam)
{% if fields %}
        existing = await self.crud.get(
            db=self.db,
            {{ fields[0].name }}=data.{{ fields[0].name }},
            schema_to_select={{ ModelName }}Read,
            return_as_model=True,
        )
        if existing:
            raise DuplicateError("{{ fields[0].name }}", data.{{ fields[0].name }})
{% endif %}

        # Create object (tenant_id injected from context by the CRUD seam)
        create_data = data.model_dump()
        create_data["user_id"] = current_user.id

        # ``BaseService.create`` is declared as the honest union
        # ``ReadSchemaT | dict | None`` because a subclass may omit
        # ``select_schema``. This service always passes one (see ``__init__``),
        # so the union collapses to the Read schema; the cast states that
        # invariant instead of widening the generated signature. mypy cannot
        # see through the generic, and a generated module MUST pass the repo's
        # own ``mypy src/`` gate.
        return cast("{{ ModelName }}Read", await self.create(**create_data))

    async def list_{{ module_name }}s(
        self,
        page: int = 1,
        items_per_page: int = 20,
    ) -> dict[str, Any]:
        """List {{ module_name }}s for the current tenant.

        Parameters
        ----------
        page : int
            Page number
        items_per_page : int
            Items per page

        Returns
        -------
        dict
            ``{"data": [...], "total_count": N}`` — the shape
            ``router.py.j2`` reads with ``.get("data")`` / ``.get("total_count")``.

        B4: this used to call ``get_multi``, which returns a LIST. The router
        template then called ``.get("data")`` on it, so every generated list
        endpoint raised ``AttributeError`` on its first request — and the
        declared ``-> dict`` return made the generated module fail ``mypy``
        before it ever ran. ``get_page_with_total`` is the single-round-trip
        paginated fetch (page + ``COUNT(*) OVER()`` in ONE statement) and
        returns exactly the dict both sides expect.
        """
        # Clamp exactly as ``get_multi`` did: this path bypasses its guards,
        # so an unbounded ``items_per_page`` would be a free way to ask for the
        # whole table (and a deep OFFSET is O(offset) in PostgreSQL).
        if page < 1:
            page = 1
        if items_per_page < 1:
            items_per_page = 1
        if items_per_page > MAX_PER_PAGE:
            items_per_page = MAX_PER_PAGE

        return await self.get_page_with_total(
            offset=(page - 1) * items_per_page,
            limit=items_per_page,
            schema_to_select={{ ModelName }}Read,
            return_as_model=True,
        )

    async def update_{{ module_name }}(
        self,
        id: int,
        data: {{ ModelName }}Update,
        current_user: AuthenticatedUser,
    ) -> {{ ModelName }}Read:
        """Update a {{ module_name }}.

        Parameters
        ----------
        id : int
            {{ ModelName }} ID
        data : {{ ModelName }}Update
            Update data
        current_user : AuthenticatedUser
            Currently authenticated user

        Returns
        -------
        {{ ModelName }}Read
            Updated {{ module_name }}

        Raises
        ------
        ModelNotFoundError
            If not found
        ForbiddenError
            If user doesn't have permission
        """
        # Get existing (tenant filter injected by the CRUD seam)
        existing = await self.crud.get(
            db=self.db,
            id=id,
        )
        if not existing:
            raise ModelNotFoundError("{{ ModelName }}", id)

        existing_user_id = existing.get("user_id") if isinstance(existing, dict) else getattr(existing, "user_id", None)
        if existing_user_id != current_user.id:
            raise ForbiddenError("You don't have permission to update this {{ module_name }}")

        # Update (typed path returns the row from the UPDATE itself)
        update_data = data.model_dump(exclude_unset=True, exclude_none=True)
        # Same invariant as ``create``: ``select_schema`` is configured, so
        # ``update`` returns the Read schema rather than the FastCRUD dict.
        return cast("{{ ModelName }}Read", await self.update(id, **update_data))

    async def delete_{{ module_name }}(
        self,
        id: int,
        current_user: AuthenticatedUser,
    ) -> None:
        """Delete a {{ module_name }}.

        Parameters
        ----------
        id : int
            {{ ModelName }} ID
        current_user : AuthenticatedUser
            Currently authenticated user

        Raises
        ------
        ModelNotFoundError
            If not found
        ForbiddenError
            If user doesn't have permission
        """
        # Get existing (tenant filter injected by the CRUD seam)
        existing = await self.crud.get(
            db=self.db,
            id=id,
        )
        if not existing:
            raise ModelNotFoundError("{{ ModelName }}", id)

        existing_user_id = existing.get("user_id") if isinstance(existing, dict) else getattr(existing, "user_id", None)
        if existing_user_id != current_user.id:
            raise ForbiddenError("You don't have permission to delete this {{ module_name }}")

        await self.crud.delete(db=self.db, id=id)
