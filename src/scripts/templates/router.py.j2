"""{{ ModelName }} router - HTTP endpoints."""

from typing import Annotated

from fastapi import APIRouter, Depends, status
from sqlalchemy.ext.asyncio import AsyncSession

from src.app.api.deps import AuthenticatedUser, get_current_user, tenant_dependency
from src.app.core.db.database import async_get_db
from src.app.core.pagination import PaginationParams, get_pagination_params
from src.app.core.tenancy.context import TenantContext
from src.app.modules.{{ module_name }}.schemas import (
    {{ ModelName }}Create,
    {{ ModelName }}List,
    {{ ModelName }}Read,
    {{ ModelName }}Update,
)
from src.app.modules.{{ module_name }}.service import {{ ModelName }}Service
from src.app.shared.exceptions import ModelNotFoundError

router = APIRouter(prefix="/{{ module_name }}s", tags=["{{ module_name }}s"])


def get_{{ module_name }}_service(db: Annotated[AsyncSession, Depends(async_get_db)]) -> {{ ModelName }}Service:
    """Dependency injection factory for {{ ModelName }}Service."""
    return {{ ModelName }}Service(db)


# Type alias for dependency injection
{{ ModelName }}ServiceDep = Annotated[
    {{ ModelName }}Service,
    Depends(get_{{ module_name }}_service)
]




@router.post("", response_model={{ ModelName }}Read, status_code=status.HTTP_201_CREATED)
async def create_{{ module_name }}(
    body: {{ ModelName }}Create,
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
) -> {{ ModelName }}Read:
    """Create a new {{ module_name }}."""
    return await service.create_{{ module_name }}(
        data=body,
        current_user=current_user,
    )


@router.get("", response_model={{ ModelName }}List)
async def list_{{ module_name }}s(
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
    pagination: Annotated[PaginationParams, Depends(get_pagination_params)],
) -> dict:
    """List {{ module_name }}s for the current tenant."""
    result = await service.list_{{ module_name }}s(
        page=pagination.page,
        items_per_page=pagination.per_page,
    )
    data = result.get("data", [])
    total = result.get("total_count", 0)
    # The envelope must describe what was ACTUALLY fetched. Echoing the raw
    # query params made it lie whenever they were clamped: ``?per_page=500``
    # returned ``MAX_PER_PAGE`` rows while reporting ``per_page=500``, and
    # ``has_next = page * per_page < total`` then said ``False`` for a page with
    # rows still behind it (page 2 computed ``offset=500`` and came back empty,
    # so rows 101-150 were unreachable at that page size).
    # ``get_pagination_params`` is the single validation surface: it enforces
    # ``ge=1`` / ``le=MAX_PER_PAGE`` and the shared deep-offset ceiling, so the
    # values read here are already the effective ones.
    return {
        "items": data,
        "total": total,
        "page": pagination.page,
        "per_page": pagination.per_page,
        "has_next": pagination.page * pagination.per_page < total,
        "has_previous": pagination.page > 1,
    }


@router.get("/{id}", response_model={{ ModelName }}Read)
async def get_{{ module_name }}(
    id: int,
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
) -> {{ ModelName }}Read:
    """Get a {{ module_name }} by ID."""
    # The canonical read, not a reach-through: ``service.get`` applies the
    # configured ``select_schema`` and the circuit-breaker guard. The old
    # template queried the CRUD handle directly from the HTTP layer with a
    # type-ignore on the schema argument, which duplicated the read contract
    # one layer too high and left ``BaseService.get`` with no caller at all.
    result = await service.get(id)
    if result is None:
        raise ModelNotFoundError("{{ ModelName }}", id)
    return {{ ModelName }}Read.model_validate(result)


@router.patch("/{id}", response_model={{ ModelName }}Read)
async def update_{{ module_name }}(
    id: int,
    body: {{ ModelName }}Update,
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
) -> {{ ModelName }}Read:
    """Update a {{ module_name }}."""
    return await service.update_{{ module_name }}(
        id=id,
        data=body,
        current_user=current_user,
    )


@router.delete("/{id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_{{ module_name }}(
    id: int,
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
) -> None:
    """Delete a {{ module_name }}."""
    await service.delete_{{ module_name }}(
        id=id,
        current_user=current_user,
    )
