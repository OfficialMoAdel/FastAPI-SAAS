"""{{ ModelName }} router - HTTP endpoints."""

from typing import Annotated

from fastapi import APIRouter, Depends, status

from src.app.api.deps import AuthenticatedUser, get_current_user, tenant_dependency
from src.app.core.db.database import async_get_db
from src.app.core.tenancy.context import TenantContext
from src.app.modules.{{ module_name }}.schemas import (
    {{ ModelName }}Create,
    {{ ModelName }}List,
    {{ ModelName }}Read,
    {{ ModelName }}Update,
)
from src.app.modules.{{ module_name }}.service import {{ ModelName }}Service, get_{{ module_name }}_service

router = APIRouter(prefix="/{{ module_name }}s", tags=["{{ module_name }}s"])

# Type alias for dependency injection
{{ ModelName }}ServiceDep = Annotated[
    {{ ModelName }}Service,
    Depends(lambda db=Depends(async_get_db): get_{{ module_name }}_service(db))
]




@router.post("", response_model={{ ModelName }}Read, status_code=status.HTTP_201_CREATED)
async def create_{{ module_name }}(
    body: {{ ModelName }}Create,
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
) -> {{ ModelName }}Read:
    """Create a new {{ module_name }}."""
    return await service.create_{{ module_name }}(
        data=body,
        current_user=current_user,
    )


@router.get("", response_model={{ ModelName }}List)
async def list_{{ module_name }}s(
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
    page: int = 1,
    per_page: int = 20,
) -> dict:
    """List {{ module_name }}s for the current tenant."""
    result = await service.list_{{ module_name }}s(
        page=page,
        items_per_page=per_page,
    )
    data = result.get("data", [])
    total = result.get("total_count", 0)
    return {
        "items": data,
        "total": total,
        "page": page,
        "per_page": per_page,
        "has_next": page * per_page < total,
        "has_previous": page > 1,
    }


@router.get("/{id}", response_model={{ ModelName }}Read)
async def get_{{ module_name }}(
    id: int,
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
) -> {{ ModelName }}Read:
    """Get a {{ module_name }} by ID."""
    # tenant filter injected from request context by the CRUD seam
    result = await service.crud.get(
        db=service.db,
        id=id,
        schema_to_select={{ ModelName }}Read,  # type: ignore[arg-type]
    )
    if not result:
        from src.app.modules._base.exceptions import ModelNotFoundError

        raise ModelNotFoundError("{{ ModelName }}", id)
    return {{ ModelName }}Read.model_validate(result)


@router.patch("/{id}", response_model={{ ModelName }}Read)
async def update_{{ module_name }}(
    id: int,
    body: {{ ModelName }}Update,
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
) -> {{ ModelName }}Read:
    """Update a {{ module_name }}."""
    return await service.update_{{ module_name }}(
        id=id,
        data=body,
        current_user=current_user,
    )


@router.delete("/{id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_{{ module_name }}(
    id: int,
    current_user: Annotated[AuthenticatedUser, Depends(get_current_user)],
    current_tenant: Annotated[TenantContext, Depends(tenant_dependency)],
    service: {{ ModelName }}ServiceDep,
) -> None:
    """Delete a {{ module_name }}."""
    await service.delete_{{ module_name }}(
        id=id,
        current_user=current_user,
    )
