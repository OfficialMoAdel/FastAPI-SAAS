  "bead": "FastAPI_saas-xfpt",
  "item": "S-8",
  "title": "The attack-scan method gate is driven over the real ASGI stack and the real logging stack: the predicate is False at INFO and True at DEBUG, a bodyless GET does not enter the body-scan gate while a POST with a body does, and the tripping user-agent trips for the recorded reason.",
  "quantity": "Behaviour, not latency. S-8's own arithmetic is 0 us, 0.00 % of the 4.09 ms uncontended floor and 0.00 % of the 740 ms p95, so this moves capacity, not p95.",
  "method": {
    "driver": "tests/e2e/feature_validation/test_s8_attack_scan_gate_e2e.py",
    "in_repo": true,
    "stack": "the real application over ASGITransport, with the real middleware stack",
    "logging_configuration": "src/app/core/logger.py::setup_logging, installed by the script",
    "hard_gate": "the bound logger is asserted to be a LevelAwareBoundLogger (A-3 landed)",
    "levels": "each case is driven twice: the module logger at INFO, then at DEBUG",
    "records": "the REAL log records, captured on the module's own stdlib logger",
    "server_clock": {
      "header": "X-Response-Time",
      "enabled_in_this_run": false,
      "note": "the flag is read once, when the guard-ordering module is imported, so a run that sets it after the application was constructed still sees no header; the absence is recorded per request with that reason"
    }
  },
