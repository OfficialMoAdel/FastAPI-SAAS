  "process_arm": {
    "verdict": "IMPOSSIBLE AS A DROP-IN - three independent reasons",
    "1_default_executor_rejects_process_pools": {
      "set_default_executor_succeeded": false,
      "error": "TypeError: executor must be ThreadPoolExecutor instance",
      "note": "CPython's BaseEventLoop.set_default_executor rejects anything that is not a ThreadPoolExecutor, so run_in_executor(None, ...) - exactly what production calls - cannot be redirected to a process pool without patching BaseEventLoop.run_in_executor itself."
    },
    "2_production_callable_is_not_picklable": {
      "lambda_pickles": false,
      "error": "AttributeError: Can't get local object 'main.<locals>.<lambda>'",
      "note": "Production submits lambda: self._check_for_patterns(...) and self is a middleware holding an ASGI app. Neither is picklable."
    },
    "3_in_place_mutation_would_be_lost": {
      "parent_list": [
        1
      ],
      "child_copy": [
        1,
        2
      ],
      "mutation_survives": false,
      "note": "detected_attacks is mutated in place. Across a process boundary it is pickled BY VALUE, so an attack found in the worker would be discarded and the caller would never learn about it. That is a security regression, not a performance question."
    },
    "process_throughput_figure": "perf-results/RESULT-20261016-l12/l12_pool_ratios.json (bead liy7, closed): the process arm runs 2.083x inline on the 60 KB miss regime and 2.614x inline on the 40 KB hit regime. That figure exists; it cannot simply be wired into the endpoint."
  },
